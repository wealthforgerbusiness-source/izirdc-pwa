# Serveur
PORT=3000

# Firebase Admin SDK (Firebase Console > Project Settings > Service Accounts)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Clé secrète perso pour protéger les routes /api/admin/* et POST /api/currency/rate
ADMIN_SECRET_KEY=

# Chariow
CHARIOW_API_KEY=
CHARIOW_LICENSE_PRODUCT_ID=
CHARIOW_PULSE_SECRET=

# URL publique de ton app (utilisée dans le redirect_url du checkout)
APP_URL=https://izirdc-pwa.onrender.com

# Optionnel — pour enrichir les actus via NewsAPI
NEWSAPI_KEY=
